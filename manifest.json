{
  "manifest_version": 3,
  "name": "Songsterr Fingering Coach",
  "version": "0.3.3",
  "description": "Songsterr Fingering Coach - Chrome Extension & Ergonomic Left-Hand Fingering Recommendation Engine with Compact Shape Coach Panel, Playback Observer and Inline Measure Overlays.",
  "host_permissions": [
    "https://www.songsterr.com/*",
    "https://*.cloudfront.net/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.songsterr.com/*"
      ],
      "css": [
        "src/ui/coach.css"
      ],
      "js": [
        "src/normalizer.js",
        "src/fingering_engine.js",
        "src/formatter.js",
        "src/ui/shape_diagram.js",
        "src/ui/measure_overlay.js",
        "src/ui/overlay_manager.js",
        "src/ui/coach_panel.js",
        "src/songsterr/playback_mapper.js",
        "src/songsterr/playback_observer.js",
        "src/controller/playback_sync_controller.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
